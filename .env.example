# Open-weights providers (hackathon credits). Paste values when they arrive; no code reads these yet.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=
BASETEN_API_KEY=
BASETEN_BASE_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Concierge sourcing inbox (the address that receives supplier requests).
# Set the real address in Vercel env + .env.local; never commit it here.
CONCIERGE_INBOX=
# Outgoing mail for concierge forwarding (a Gmail app password works).
# Optional for now: until set, the user's own mail client sends the
# notification via a prefilled draft, and the queued row is the record.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The Supabase variables are injected by the Vercel integration; pull them with `vercel env pull .env.local`.
